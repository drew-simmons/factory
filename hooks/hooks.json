{
  "description": "factory: report tool availability at session start; while a verify loop is armed, block a red turn from ending (Stop and SubagentStop, so implementer agents in worktrees are gated too)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/verify-stop.sh\"",
            "timeout": 1800
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/verify-stop.sh\"",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
